{
  "name": "electron-audio-recorder",
  "version": "1.0.0",
  "description": "Windows system audio recorder with per-device loopback capture",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:capture": "dotnet publish ./capture/capture.csproj -c Release -r win-x64 --self-contained -o ./bin/capture /p:PublishSingleFile=true /p:IncludeNativeLibrariesForSelfExtract=true",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.example.electron-audio-recorder",
    "productName": "AudioRecorder",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "wav-utils.js",
      "mixer-processor.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin/capture",
        "to": "bin/capture",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AudioRecorder"
    }
  }
}
